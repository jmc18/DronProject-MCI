{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Start Services",
      "type": "shell",
      "command": "pnpm docker:up",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Docker: Stop Services",
      "type": "shell",
      "command": "pnpm docker:down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Logs",
      "type": "shell",
      "command": "pnpm docker:logs",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Prisma: Generate",
      "type": "shell",
      "command": "pnpm prisma:generate",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Prisma: Migrate",
      "type": "shell",
      "command": "pnpm prisma:migrate",
      "options": {
        "cwd": "${workspaceFolder}",
        "envFile": "${workspaceFolder}/apps/web/.env"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Setup: Local env files",
      "type": "shell",
      "command": "test -f .env || cp .env.example .env; pnpm setup:web-env; pnpm setup:analyzer-env",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Python: Create venv + install",
      "type": "shell",
      "command": "bash scripts/setup_venv.sh",
      "options": { "cwd": "${workspaceFolder}/services/analyzer" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Next.js: Dev (watch)",
      "type": "shell",
      "command": "pnpm --filter web dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Starting|ready|Local:).*",
          "endsPattern": ".*(Ready|started server|Local:).*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Python: Analyzer Watch",
      "type": "shell",
      "command": ".venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/services/analyzer",
        "envFile": "${workspaceFolder}/services/analyzer/.env"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "python",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Started|Uvicorn|Waiting).*",
          "endsPattern": ".*(Application startup complete|Uvicorn running).*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
