[Unit]
Description=bachedron.javier.tech
After=network.target

[Service]
WorkingDirectory=/var/www/javiermc/bachedron/web/apps/web
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=bachedron.javier.tech
LogsDirectory=bachedron
StandardOutput=append:/var/log/bachedron/web.log
StandardError=append:/var/log/bachedron/web.log
User=jmcdeploy
Group=jmcdeploy
Environment=NODE_ENV=production
Environment=PORT=3010
Environment=HOSTNAME=127.0.0.1
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
Environment=ANALYZER_URL=http://127.0.0.1:8010
Environment=JOBS_DIR=/var/www/javiermc/bachedron/data/jobs
Environment=AUTO_MIGRATE=0
EnvironmentFile=-/var/www/javiermc/bachedron/web.env

[Install]
WantedBy=multi-user.target
