# Entorno local de Next.js + Prisma (mismo archivo para ambos).
# Copiar: cp apps/web/.env.example apps/web/.env
# Prisma NO carga `.env.local`; usa este `.env`.

NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Monitoreo Vial con Drones"

# Postgres de Docker publicado en el host en 5433 (dentro del contenedor sigue siendo 5432).
DATABASE_URL=postgresql://vial:change_me_strong_password@127.0.0.1:5433/vial_monitor?schema=public

# Analyzer en el host (uvicorn --reload)
ANALYZER_URL=http://127.0.0.1:8000

IOT_DEVICE_TOKEN=change_me_device_token
UPLOAD_DIR=uploads
JOBS_DIR=uploads/jobs

# Seguridad upload de vídeo
API_KEY_CURRENT=change_me_api_key_current
API_KEY_PREVIOUS=
UPLOAD_HMAC_SECRET=change_me_hmac_secret
INTERNAL_TOKEN=change_me_internal_token
MAX_UPLOAD_MB=8192
MIN_FREE_DISK_GB=5
MODEL_WHITELIST=pothole_seg
RATE_LIMIT_PER_MINUTE=60
JOB_TIMEOUT_MINUTES=180
RETENTION_DAYS=30
DELETE_ORIGINAL_AFTER_DAYS=7
NEXT_PUBLIC_MAX_UPLOAD_MB=8192

# Migraciones al arrancar (como Database.Migrate en EF Core). 0 = desactivar.
AUTO_MIGRATE=1
PRISMA_MIGRATE_RETRIES=30
PRISMA_MIGRATE_RETRY_MS=2000
