# =============================================================================
# Variables compartidas (Docker Compose + referencia)
# Copiar a `.env` en la raíz:  cp .env.example .env
# =============================================================================

# PostgreSQL (Compose + Prisma)
POSTGRES_USER=vial
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vial_monitor

# URL usada por el servicio `web` en perfil prod (hostname Docker).
# Para desarrollo local de Next.js usa apps/web/.env.local (localhost).
DATABASE_URL=postgresql://vial:change_me_strong_password@postgres:5432/vial_monitor?schema=public

# Next.js (perfil prod en Docker)
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Monitoreo Vial con Drones"
ANALYZER_URL=http://analyzer:8000
MQTT_URL=mqtt://mosquitto:1883
IOT_DEVICE_TOKEN=change_me_device_token
UPLOAD_DIR=/app/uploads
WEB_PORT=3000

# Mosquitto (opcional; conf actual permite anónimo en local)
MQTT_USERNAME=vial
MQTT_PASSWORD=change_me_mqtt_password

# Analyzer (perfil prod en Docker)
YOLO_WEIGHTS_PATH=/app/models/pothole_seg.pt
ANALYZER_PORT=8000
