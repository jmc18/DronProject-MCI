# =============================================================================
# Variables compartidas (Docker Compose + referencia)
# Copiar a `.env` en la raíz:  cp .env.example .env
# =============================================================================

# PostgreSQL (Compose + Prisma)
POSTGRES_USER=vial
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vial_monitor

# URL usada por el servicio `web` en perfil prod (hostname Docker).
# Para desarrollo local de Next.js usa apps/web/.env.local (localhost).
DATABASE_URL=postgresql://vial:change_me_strong_password@postgres:5432/vial_monitor?schema=public

# Next.js (perfil prod en Docker)
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Monitoreo Vial con Drones"
ANALYZER_URL=http://analyzer:8000
IOT_DEVICE_TOKEN=change_me_device_token
UPLOAD_DIR=/app/uploads
JOBS_DIR=/app/uploads/jobs
WEB_PORT=3000

# Seguridad upload de vídeo
API_KEY_CURRENT=change_me_api_key_current
API_KEY_PREVIOUS=
UPLOAD_HMAC_SECRET=change_me_hmac_secret
INTERNAL_TOKEN=change_me_internal_token
MAX_UPLOAD_MB=8192
MIN_FREE_DISK_GB=20
MODEL_WHITELIST=pothole_seg
RATE_LIMIT_PER_MINUTE=30
JOB_TIMEOUT_MINUTES=180
RETENTION_DAYS=30
DELETE_ORIGINAL_AFTER_DAYS=7
NEXT_PUBLIC_MAX_UPLOAD_MB=8192
AUTO_MIGRATE=1

# Analyzer (perfil prod en Docker)
YOLO_WEIGHTS_PATH=/app/models/pothole_seg.pt
ANALYZER_PORT=8000
FRAME_STRIDE=15
TARGET_ANALYSIS_FPS=3
TILE_SIZE=1280
TILE_OVERLAP=0.2
IMGSZ=640
CONFIDENCE_THRESHOLD=0.35
PROCESSED_MAX_HEIGHT=1440
WORKER_TMP_DIR=/tmp/vial-worker
WEB_INTERNAL_URL=http://web:3000
