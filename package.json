{
  "name": "dronproject-mci",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:python": "node scripts/dev-python.mjs",
    "build:web": "pnpm --filter web build",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "docker:prod": "docker compose --profile prod up -d --build",
    "db:up": "docker compose up -d postgres",
    "stack:up": "docker compose --profile prod up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "prisma:generate": "pnpm --filter web prisma:generate",
    "prisma:migrate": "pnpm --filter web prisma:migrate",
    "prisma:deploy": "pnpm --filter web prisma:deploy",
    "setup:web-env": "test -f apps/web/.env || cp apps/web/.env.example apps/web/.env",
    "setup:analyzer-venv": "bash services/analyzer/scripts/setup_venv.sh",
    "setup:analyzer-env": "test -f services/analyzer/.env || cp services/analyzer/.env.example services/analyzer/.env",
    "update:deps": "pnpm update -r --latest",
    "test:upload-security": "node apps/web/scripts/test-upload-security.mjs",
    "retention:cleanup": "node apps/web/scripts/retention-cleanup.mjs"
  }
}
