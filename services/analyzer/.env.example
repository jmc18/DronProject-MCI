# Entorno local del analyzer FastAPI.
# Copiar: cp services/analyzer/.env.example services/analyzer/.env

# Si existe model/best.pt del repo local, el worker lo usa aunque esta ruta no exista.
YOLO_WEIGHTS_PATH=./models/pothole_seg.pt
SAMPLE_FACTOR=2
QUANTIZE_LEVELS=8
BINARY_THRESHOLD=110
CROP_MARGIN_RATIO=0.1

# Auth interna (Next.js ↔ worker). Nunca exponer a internet.
INTERNAL_TOKEN=change_me_internal_token
WEB_INTERNAL_URL=http://127.0.0.1:3000

# Pipeline vídeo 8K
FRAME_STRIDE=15
TARGET_ANALYSIS_FPS=3
TILE_SIZE=1280
TILE_OVERLAP=0.2
# ROI opcional: x,y,w,h en píxeles del frame original (vacío = frame completo)
ROI=
IMGSZ=640
CONFIDENCE_THRESHOLD=0.35
PROCESSED_MAX_HEIGHT=1440
WORKER_TMP_DIR=./tmp
JOB_TIMEOUT_MINUTES=180
PROGRESS_INTERVAL_SEC=5
